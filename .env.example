# Optional: copy to server/.env to configure the LLM before first launch.
# Everything here can also be set later in the web UI (设置 → LLM), which is
# stored in server/data/settings.json and takes precedence over this file.

LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=your-model-name
